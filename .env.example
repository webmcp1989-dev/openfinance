# Each Vercel project receives the credentials for only its own Supabase project.
# Never place a service-role or database password in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# OpenFinance AR only. Must be its public, canonical HTTPS resource URL.
OPENFINANCE_MCP_URL=https://openfinance-ar.vercel.app/mcp
